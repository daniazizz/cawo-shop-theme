{%- style -%}
  @font-face {
    font-family: 'Monument Extended';
    src: url('https://cdn.shopify.com/s/files/1/0903/9351/0231/files/MonumentExtended-Ultrabold.woff2?v=1747952135') format('woff2');
    font-weight: 900;
    font-style: normal;
  }

  .hero-banner-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ section.settings.background_color }};
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.spacing | times: 1.5 }}vw;
  }
  .hero-banner-{{ section.id }} .hero-banner__darken {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
    z-index: 1;
  }
  {% if section.settings.enable_vignette %}
    .hero-banner-{{ section.id }} .hero-banner__vignette {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      box-shadow: inset 0 0 {{ section.settings.vignette_strength }}vw rgba(0, 0, 0, 0.7);
      pointer-events: none;
      z-index: 2;
    }
  {% endif %}
  .hero-banner-{{ section.id }} .hero-banner__overlay {
    position: relative;
    z-index: 3;
    text-align: center;
    text-transform: uppercase;
    width: 100%;
    max-width: 90%;
  }
  .hero-banner-{{ section.id }} .hero-banner__pretitle {
    font-size: {{ section.settings.text_scale | times: 0.42 }}vw;
    color: {{ section.settings.text_color }};
    letter-spacing: 0.15em;
    margin-bottom: {{ section.settings.spacing | times: 0.3 }}vw;
    font-family: 'Monument Extended', sans-serif;
  }
  .hero-banner-{{ section.id }} .hero-banner__heading {
    font-size: {{ section.settings.text_scale }}vw;
    margin: 0 0 {{ section.settings.spacing | times: 0.4 }}vw;
    color: {{ section.settings.text_color }};
    line-height: 1.1;
    font-family: 'Monument Extended', sans-serif;
    font-weight: 900;
  }
  .hero-banner-{{ section.id }} .hero-banner__subtitle {
    font-size: {{ section.settings.text_scale | times: 0.46 }}vw;
    color: {{ section.settings.text_color }};
    margin-bottom: {{ section.settings.spacing | times: 0.5 }}vw;
    font-family: 'Monument Extended', sans-serif;
  }
  .hero-banner-{{ section.id }} .hero-banner__button {
    display: inline-block;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    font-weight: 900;
    font-size: {{ section.settings.text_scale | times: 0.54 }}vw;
    padding: {{ section.settings.text_scale | times: 0.3 }}vw {{ section.settings.text_scale | times: 0.8 }}vw;
    text-decoration: none;
    transform: skew(-15deg);
    border: none;
    font-family: 'Monument Extended', sans-serif;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }
  .hero-banner-{{ section.id }} .hero-banner__button:hover {
    opacity: 0.85;
  }
  .hero-banner-{{ section.id }} .hero-banner__button-text {
    display: inline-block;
    transform: skew(15deg);
  }

  {% unless section.settings.show_on_desktop %}
    @media screen and (min-width: 768px) {
      .hero-banner-{{ section.id }} {
        display: none !important;
      }
    }
  {% endunless %}

  {% unless section.settings.show_on_mobile %}
    @media screen and (max-width: 767px) {
      .hero-banner-{{ section.id }} {
        display: none !important;
      }
    }
  {% endunless %}
{%- endstyle -%}

<div class="hero-banner-{{ section.id }}"
  {% if section.settings.image != blank %}
    style="background-image: url('{{ section.settings.image | image_url: width: 1920 }}');"
  {% endif %}
>
  <div class="hero-banner__darken"></div>
  {% if section.settings.enable_vignette %}
    <div class="hero-banner__vignette"></div>
  {% endif %}
  <div class="hero-banner__overlay">
    {% if section.settings.pretitle != blank %}
      <div class="hero-banner__pretitle">{{ section.settings.pretitle }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="hero-banner__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <div class="hero-banner__subtitle">{{ section.settings.subtitle }}</div>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link }}" class="hero-banner__button">
        <span class="hero-banner__button-text">{{ section.settings.button_text }}</span>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "pretitle",
      "default": "🌙 PROMOTION EID",
      "label": "Pre-title"
    },
    {
      "type": "richtext",
      "id": "heading",
      "default": "<p>PRIX LE PLUS BAS<br>DE L'ANNÉE</p>",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "Shorts CAWO en promotion",
      "label": "Subtitle"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "PROFITER DE L'OFFRE ›",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#ffffff",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#000000",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "button_background",
      "default": "#ffffff",
      "label": "Button background"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "default": "#000000",
      "label": "Button text color"
    },
    {
      "type": "range",
      "id": "text_scale",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "label": "Text size",
      "info": "Scales all text proportionally"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Spacing",
      "info": "Controls padding and gaps between elements"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 20,
      "label": "Image darkening",
      "info": "0 = no darkening, higher = darker overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_vignette",
      "default": false,
      "label": "Enable vignette effect"
    },
    {
      "type": "range",
      "id": "vignette_strength",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 15,
      "label": "Vignette strength",
      "info": "Size of the dark edge shadow"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "default": true,
      "label": "Show on desktop"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "default": true,
      "label": "Show on mobile"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
